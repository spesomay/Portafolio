# Puerto en el que corre el servidor backend de Express
PORT=5000

# (Opcional) Configuración de Nodemailer para enviar correos reales
# Si deseas que los mensajes te lleguen a tu casilla Gmail:
# 1. Ve a tu cuenta de Google -> Seguridad -> Verificación en dos pasos -> Contraseñas de aplicaciones.
# 2. Genera una contraseña para "Correo" y pégala aquí abajo sin espacios.
EMAIL_SERVICE=gmail
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_password_de_aplicacion
EMAIL_RECEIVER=maylenspeso@gmail.com
